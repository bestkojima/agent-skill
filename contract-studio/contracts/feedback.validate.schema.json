{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/feedback.validate.schema.json",
  "title": "feedback.validate v1",
  "description": "Demo capability: returns a normalized feedback form or a typed validation error.",
  "$defs": {
    "input": {
      "type": "object",
      "properties": {"title": {"type": "string"}, "category": {"type": "string"}, "detail": {"type": "string"}},
      "additionalProperties": false
    },
    "output": {
      "oneOf": [
        {"type": "object", "properties": {"status": {"const": "valid"}, "input": {"$ref": "#/$defs/input"}}, "required": ["status", "input"], "additionalProperties": false},
        {"type": "object", "properties": {"status": {"const": "invalid"}, "code": {"enum": ["INVALID_TITLE", "INVALID_CATEGORY", "INVALID_DETAIL"]}, "message": {"type": "string"}}, "required": ["status", "code", "message"], "additionalProperties": false}
      ]
    }
  }
}
